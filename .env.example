# ─────────────────────────────────────────────────────────────────────────────
# Tapo P110 Energy & Cost Dashboard — environment template
# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# --- Tapo P110 (LAN-local; poller MUST run on the same network as the plug) ---
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=your-tapo-account-password
# Assign a DHCP reservation so this never changes:
TAPO_DEVICE_IP=192.168.1.50
# Optional friendly name shown in the UI:
TAPO_DEVICE_NICKNAME=Living Room AC

# --- Timezone (India has no DST) ---
TZ=Asia/Kolkata

# --- Database (shared SQLite file; poller writes, web reads) ---
# Path is relative to repo root for local dev; in Docker it's a shared volume.
DATABASE_URL=./data/energy.db

# --- Cost / display settings ---
# India grid emission factor (kg CO2 per kWh). ~0.7–0.82; tune to your region.
EMISSION_FACTOR_KG_PER_KWH=0.79

# --- Poller cadences (seconds) — defaults match the spec ---
POLL_POWER_SECONDS=15
POLL_ENERGY_SECONDS=300
# Daily reconcile job runs at 00:05 IST.
DAILY_JOB_IST_HOUR=0
DAILY_JOB_IST_MINUTE=5
# Prune raw power_samples older than this many days (0 = never).
POWER_SAMPLE_RETENTION_DAYS=90

# --- Optional remote variant (poller syncs SQLite -> Turso; web on Vercel) ---
# Leave blank to use the default local SQLite path above.
TURSO_URL=
TURSO_TOKEN=
